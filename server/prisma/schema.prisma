generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Study {
  id             Int      @id @default(autoincrement())
  title          String
  excerpt        String
  content        String
  category       String
  author         String
  classification String
  tags           String   // JSON stringified array of strings
  timestamp      DateTime @default(now())
}

model Complaint {
  id             Int      @id @default(autoincrement())
  type           String   @default("Umum") // Umum, Perempuan
  headline       String
  excerpt        String
  category       String
  classification String
  status         String   @default("Terkirim") // Terkirim, Diproses, Selesai
  timestamp      DateTime @default(now())
}
